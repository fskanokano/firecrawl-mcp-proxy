# ============================================================
# 只有这两个环境变量
# ============================================================

# 1) 代理自身的 Key：客户端用这个 Key 连接你的代理（不是 Firecrawl 的 Key）
#    生成方式： openssl rand -hex 32
PROXY_API_KEY=replace-with-a-long-random-secret

# 2) Firecrawl 的 API Key：由代理保存在服务端并注入到上游请求里
#    获取地址： https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
